# Model endpoint (OpenAI-compatible; OpenRouter by default)
OPENROUTER_API_KEY=
OBLIRCA_MODEL=deepseek/deepseek-chat-v3.1
OBLIRCA_BASE_URL=https://openrouter.ai/api/v1
OBLIRCA_LLM_TIMEOUT=90
OBLIRCA_LLM_TEMPERATURE=0.1
OBLIRCA_LLM_MAX_TOKENS=2400

# Storage: SQLite by default; set a MySQL URL to use the paper's deployment shape.
OBLIRCA_DB_URL=sqlite:///data/obli_rca.db

# Tool paths
JOERN_HOME=
ANGR_ENABLED=0
SYSDIG_BIN=sysdig

# Runtime limits
OBLIRCA_MAX_SOI=10
OBLIRCA_TOOL_BUDGET=24
OBLIRCA_MAX_HOPS=4
OBLIRCA_FEEDBACK_ROUNDS=2
